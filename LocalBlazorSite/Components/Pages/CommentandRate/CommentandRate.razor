@page "/comment-and-rate"
@rendermode InteractiveServer

<!-- Load Inter font -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<div class="relative w-[1080px] h-[1300px] mx-auto bg-gradient-to-b from-[#000000] to-[#33184F] overflow-hidden" style="font-family: 'Inter', sans-serif;">
    
    <!-- Pattern Overlay -->
    <img src="/images/gradient-pattern.png" 
         class="absolute bottom-0 left-0 w-full pointer-events-none opacity-80" 
         alt="" />

    <!-- Content Wrapper -->
    <div class="relative z-10 w-full h-full flex flex-col text-white">
        
        <!-- Navigation Bar -->
        <nav style="display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 40px 60px; box-sizing: border-box;">
            <div style="display: flex; align-items: center;">
                <img src="/images/logo.png" alt="Logo" style="height: 40px;" />
                <div style="height: 40px; width: 2px; background-color: white; margin-left: 20px; margin-right: 20px;"></div>
                <span style="font-weight: bold; letter-spacing: 0.1em; font-size: 16px; text-transform: uppercase;">Video Games</span>
            </div>

            <div style="display: flex; align-items: center; gap: 70px; font-size: 14px;">
                <a href="#" style="color: white; text-decoration: none;" class="hover:opacity-75 transition-opacity">Home</a>
                <a href="#" style="color: white; text-decoration: none;" class="hover:opacity-75 transition-opacity">Community</a>
                <a href="#" style="color: white; text-decoration: none;" class="hover:opacity-75 transition-opacity">About us</a>
                <a href="/comment-and-rate" style="color: white; text-decoration: underline; text-underline-offset: 8px;">Rating and Comment</a>
            </div>
        </nav>

        <!-- Center Area -->
        <div style="display: flex; flex-direction: column; align-items: center; margin-top: 15px;">
            
            <div style="text-align: center; margin-bottom: 25px;">
                <h1 style="font-size: 26px; font-weight: 700; margin: 0 0 6px 0; letter-spacing: -0.5px;">We Value Your Feedback</h1>
                <p style="font-size: 14px; color: #9ca3af; margin: 0;">Help us improve your gaming experience by leaving a review.</p>
            </div>

            <!-- White Card -->
            <div style="width: 900px; background-color: white; border-radius: 20px; padding: 40px 50px; box-sizing: border-box; color: #1e1e1e; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
                
                <!-- Name Field -->
                <div style="margin-bottom: 22px;">
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 8px;">Name</label>
                    <input type="text" 
                           @bind="userName" 
                           @bind:event="oninput"
                           placeholder="Enter your name (e.g., Anonymous)" 
                           style="width: 350px; height: 42px; border: 1px solid #d1d5db; border-radius: 8px; padding: 0 15px; font-size: 14px; outline: none; box-sizing: border-box;" />
                </div>

                <!-- Rating Question with Half-Star Support -->
                <div style="margin-bottom: 22px;">
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 10px;">
                        How would you rate the quality of this website? @(rating > 0 ? $"({rating} / 5)" : "")
                    </label>
                    
                    <div style="display: flex; gap: 8px; align-items: center;">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var starIndex = i;
                            <div style="position: relative; width: 30px; height: 30px; cursor: pointer;" title="@starIndex Stars">
                                <!-- Left half click target -->
                                <div @onclick="() => SetRating(starIndex - 0.5)" style="position: absolute; left: 0; top: 0; width: 50%; height: 100%; z-index: 2;"></div>
                                <!-- Right half click target -->
                                <div @onclick="() => SetRating(starIndex)" style="position: absolute; right: 0; top: 0; width: 50%; height: 100%; z-index: 2;"></div>

                                <svg style="width: 30px; height: 30px; position: absolute; left: 0; top: 0;" viewBox="0 0 20 20">
                                    <defs>
                                        <linearGradient id="half-@starIndex" x1="0" x2="1" y1="0" y2="0">
                                            <stop offset="50%" stop-color="#fbbf24" />
                                            <stop offset="50%" stop-color="#d1d5db" />
                                        </linearGradient>
                                    </defs>
                                    
                                    @{
                                        string fillColor = "#d1d5db";
                                        if (rating >= starIndex)
                                        {
                                            fillColor = "#fbbf24";
                                        }
                                        else if (rating >= starIndex - 0.5)
                                        {
                                            fillColor = $"url(#half-{starIndex})";
                                        }
                                    }

                                    <path fill="@fillColor" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                </svg>
                            </div>
                        }
                    </div>
                </div>

                <!-- Comment Section -->
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 8px;">Add a comment (Optional)</label>
                    
                    <div style="position: relative; border: 1px solid #d1d5db; border-radius: 12px; padding: 15px; background-color: #f9fafb; box-sizing: border-box;">
                        
                        <textarea rows="7" 
                                  maxlength="300"
                                  @bind="userComment"
                                  @bind:event="oninput"
                                  placeholder="Write your thoughts here..." 
                                  style="width: 100%; border: none; outline: none; resize: none; font-family: 'Inter', sans-serif; font-size: 14px; background: transparent; color: #1f2937;"></textarea>
                        
                        <!-- Bottom Bar (Character count & Send Icon) -->
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px; border-top: 1px solid #e5e7eb; padding-top: 10px;">
                            <span style="font-size: 12px; color: #9ca3af; font-weight: 500;">@(userComment?.Length ?? 0)/300</span>
                            
                            <!-- Submit / Send Button -->
                            <div @onclick="HandleSubmit"
                                 style="background-color: #eff6ff; padding: 8px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background-color 0.2s;"
                                 title="Submit Feedback">
                                <svg style="width: 20px; height: 20px; color: #2563eb; transform: rotate(45deg);" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                                </svg>
                            </div>
                        </div>
                        
                    </div>
                </div>

                <!-- Validation Warning Message -->
                @if (!string.IsNullOrEmpty(warningMessage))
                {
                    <div style="margin-top: 15px; padding: 10px 14px; background-color: #fee2e2; color: #b91c1c; border-radius: 8px; font-size: 13px; font-weight: 500;">
                        @warningMessage
                    </div>
                }

            </div>

        </div>

    </div>

</div>